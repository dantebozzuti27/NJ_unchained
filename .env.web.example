# NJ Unchained — screener env vars
# Copy to .env.local for `npm run dev`; set the same vars in the
# Vercel project (Settings → Environment Variables) for production.

# Neon Postgres connection string. Use the POOLED connection string
# (Neon's "Connection details → Pooled connection → psql" snippet),
# not the direct one — the @neondatabase/serverless driver routes
# through Neon's HTTP edge proxy, which expects the pooler endpoint.
#
# Example: postgres://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_DATABASE_URL=
